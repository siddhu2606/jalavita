# Copy this file to `.env` (same folder) and fill in real values from
# https://console.twilio.com — Account SID + Auth Token are on the Account
# Dashboard, the phone number comes from Phone Numbers > Manage > Buy a number.
# `.env` is gitignored — never commit real credentials.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
